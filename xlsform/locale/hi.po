#: xlsform/core/issues.py:317
#, python-brace-format
msgid "\"{column}\" uses {name}, whose calculation can only run when the form is saved."
msgstr "\"{column}\" में {name} का उपयोग है, जिसकी गणना केवल फ़ॉर्म सहेजते समय हो सकती है।"

#: xlsform/core/issues.py:125
#, python-brace-format
msgid "\"{name}\" can't be used as a name: {reason}."
msgstr "\"{name}\" को नाम के रूप में इस्तेमाल नहीं किया जा सकता: {reason}।"

#: xlsform/core/issues.py:181
#, python-brace-format
msgid "\"{type}\" (row {row}) can't be collected in this app and will be ignored."
msgstr "\"{type}\" (पंक्ति {row}) इस ऐप में एकत्र नहीं किया जा सकता और अनदेखा किया जाएगा।"

#: xlsform/core/issues.py:169
#, python-brace-format
msgid "\"{type}\" isn't a question type."
msgstr "\"{type}\" कोई प्रश्न प्रकार नहीं है।"

#: xlsform/core/issues.py:175
#, python-brace-format
msgid "\"{type}\" questions aren't supported yet (row {row})."
msgstr "\"{type}\" प्रश्न अभी समर्थित नहीं हैं (पंक्ति {row})।"

#: xlsform/core/meaning.py:171
msgid ", or use select_multiple"
msgstr ", या select_multiple का उपयोग करें"

#: xlsform/core/meaning.py:646
msgid "1 value"
msgstr "1 मान"

#. Header text in the Excel Forms Workspace
#: xlsform/xlsform/workspace/excel_forms/excel_forms.json:3
msgid "<span class=\"h4\"><b>Forms built in Excel</b></span>"
msgstr "<span class=\"h4\"><b>Excel में बने फ़ॉर्म</b></span>"

#: xlsform/xlsform/doctype/xlsform/xlsform.py:53
msgid "A published form can't be deleted, because its data would be lost. Retire it instead."
msgstr "प्रकाशित फ़ॉर्म हटाया नहीं जा सकता, क्योंकि उसका डेटा खो जाएगा। इसके बजाय इसे बंद करें।"

#: xlsform/xlsform/doctype/xlsform_version/xlsform_version.py:55
msgid "A published version can't be cancelled. Upload a new version, or retire the form."
msgstr "प्रकाशित संस्करण रद्द नहीं किया जा सकता। नया संस्करण अपलोड करें, या फ़ॉर्म बंद करें।"

#: xlsform/xlsform/doctype/xlsform_version/xlsform_version.js:120
msgid "A published version can't be edited; to change the form later, upload a new version."
msgstr "प्रकाशित संस्करण बदला नहीं जा सकता; बाद में फ़ॉर्म बदलने के लिए नया संस्करण अपलोड करें।"

#. Label of the access (Table) field in DocType 'XLSForm'
#: xlsform/xlsform/doctype/xlsform/xlsform.json:123
msgid "Access"
msgstr "पहुँच"

#: xlsform/core/issues.py:338
#, python-brace-format
msgid "Add a \"{choice_column}\" column to the choices sheet."
msgstr "choices शीट में \"{choice_column}\" कॉलम जोड़ें।"

#: xlsform/core/issues.py:96
#, python-brace-format
msgid "Add a column named {column} in row 1."
msgstr "पंक्ति 1 में {column} नाम का कॉलम जोड़ें।"

#: xlsform/core/issues.py:472
msgid "Add a label."
msgstr "एक लेबल जोड़ें।"

