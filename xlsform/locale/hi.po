#, python-brace-format
msgid "Add a question type for {name} in the type column."
msgstr "type कॉलम में {name} के लिए प्रश्न प्रकार जोड़ें।"

#: xlsform/core/issues.py:120
#, python-brace-format
msgid "Add a short name, e.g. {example}."
msgstr "एक छोटा नाम जोड़ें, जैसे {example}।"

#: xlsform/core/issues.py:138
#, python-brace-format
msgid "Add an {end} row where the {kind} should end."
msgstr "जहाँ {kind} समाप्त होना चाहिए, वहाँ {end} पंक्ति जोड़ें।"

