   "expr": "${n} + ${n2} > 10",
   "doc": {
    "n": 6,
    "n2": 5
   },
   "expected": true
  },
  {
   "id": "num-add-blank",
   "expr": "${n} + ${n2} > 10",
   "doc": {
    "n": 6,
    "n2": null
   },
   "expected": false
  },
  {
   "id": "num-add-both-blank",
   "expr": "${n} + ${n2} > 10",
   "doc": {
    "n": null,
    "n2": null
   },
   "expected": false
  },
  {
   "id": "num-add-ne-blank",
   "expr": "${n} + ${n2} != 10",
   "doc": {
    "n": 6,
    "n2": null
   },
   "expected": true
  },
  {
   "id": "num-mul",
   "expr": "${n} * 2 = 10",
   "doc": {
    "n": 5
   },
   "expected": true
  },
  {
   "id": "num-div",
   "expr": "${n} div 2 = 2.5",
   "doc": {
    "n": 5
   },
   "expected": true
  },
  {
   "id": "num-mod",
   "expr": "${n} mod 3 = 1",
   "doc": {
    "n": 7
   },
   "expected": true
  },
  {
   "id": "num-mod-neg",
   "expr": "${n} mod 3 = -1",
   "doc": {
    "n": -7
   },
   "expected": true
  },
  {
   "id": "num-neg",
   "expr": "-${n} < 0",
   "doc": {
    "n": 3
   },
   "expected": true
  },
  {
   "id": "num-neg-blank",
   "expr": "-${n} < 0",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-sub",
   "expr": "${n} - ${n2} = 0",
   "doc": {
    "n": 4,
    "n2": 4
   },
   "expected": true
  },
  {
   "id": "num-precedence",
   "expr": "${n} + 2 * 3 = 10",
   "doc": {
    "n": 4
   },
   "expected": true
  },
  {
   "id": "num-parens",
   "expr": "(${n} + 2) * 3 = 18",
   "doc": {
    "n": 4
   },
   "expected": true
  },
  {
   "id": "num-div-zero",
   "expr": "${n} div 0 > 1000",
   "doc": {
    "n": 4
   },
   "expected": true
  },
  {
   "id": "num-literal-only",
   "expr": "3 > 2",
   "doc": {},
   "expected": true
  },
  {
   "id": "num-decimal-literal",
   "expr": ".5 < 1",
   "doc": {},
   "expected": true
  },
  {
   "id": "num-neg-literal",
   "expr": "${n} > -2.5",
   "doc": {
    "n": -2
   },
   "expected": true
  },
  {
   "id": "num-str-literal",
   "expr": "${n} = '5'",
   "doc": {
    "n": 5
   },
   "expected": true
  },
  {
   "id": "num-str-literal-blank",
   "expr": "${n} = '5'",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-chain",
   "expr": "${n} > 1 and ${n} < 10",
   "doc": {
    "n": 5
   },
   "expected": true
  },
  {
   "id": "num-chain-blank",
   "expr": "${n} > 1 or ${n} < 10",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-text-gt",
   "expr": "${t} > 5",
   "doc": {
    "t": "7"
   },
   "expected": true
  },
  {
   "id": "num-text-eq",
   "expr": "${t} = 5",
   "doc": {
    "t": "5"
   },
   "expected": true
  },
  {
   "id": "num-text-eq-decimal",
   "expr": "${t} = 5",
   "doc": {
    "t": "5.0"
   },
   "expected": true
  },
  {
   "id": "num-text-eq-blank",
   "expr": "${t} = 5",
   "doc": {
    "t": ""
   },
   "expected": false
  },
  {
   "id": "num-text-gt-blank",
   "expr": "${t} > 0",
   "doc": {
    "t": null
   },
   "expected": false
  },
  {
   "id": "num-zero-answered-gt",
   "expr": "${n} >= 0",
