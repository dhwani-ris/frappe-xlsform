{
 "group": "Numbers and blanks",
 "cases": [
  {
   "id": "num-gt-1",
   "expr": "${n} > 5",
   "doc": {
    "n": 7
   },
   "expected": true
  },
  {
   "id": "num-gt-2",
   "expr": "${n} > 5",
   "doc": {
    "n": 5
   },
   "expected": false
  },
  {
   "id": "num-gt-blank",
   "expr": "${n} > 5",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-gt-zero",
   "expr": "${n} > -1",
   "doc": {
    "n": 0
   },
   "expected": true
  },
  {
   "id": "num-lt-blank",
   "expr": "${n} < 5",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-lt-1",
   "expr": "${n} < 5",
   "doc": {
    "n": 3
   },
   "expected": true
  },
  {
   "id": "num-le-zero",
   "expr": "${n} <= 0",
   "doc": {
    "n": 0
   },
   "expected": true
  },
  {
   "id": "num-le-blank",
   "expr": "${n} <= 0",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-eq-1",
   "expr": "${n} = 5",
   "doc": {
    "n": 5
   },
   "expected": true
  },
  {
   "id": "num-eq-blank",
   "expr": "${n} = 5",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-ne-blank",
   "expr": "${n} != 5",
   "doc": {
    "n": null
   },
   "expected": true
  },
  {
   "id": "num-ne-same",
   "expr": "${n} != 5",
   "doc": {
    "n": 5
   },
   "expected": false
  },
  {
   "id": "num-ne-diff",
   "expr": "${n} != 5",
   "doc": {
    "n": 6
   },
   "expected": true
  },
  {
   "id": "num-eq-empty-blank",
   "expr": "${n} = ''",
   "doc": {
    "n": null
   },
   "expected": true
  },
  {
   "id": "num-eq-empty-zero",
   "expr": "${n} = ''",
   "doc": {
    "n": 0
   },
   "expected": false
  },
  {
   "id": "num-ne-empty-blank",
   "expr": "${n} != ''",
   "doc": {
    "n": null
   },
   "expected": false
  },
  {
   "id": "num-ne-empty-answered",
   "expr": "${n} != ''",
   "doc": {
    "n": 3
   },
   "expected": true
  },
  {
   "id": "num-eq-field-blank",
   "expr": "${n} = ${n2}",
   "doc": {
    "n": null,
    "n2": null
   },
   "expected": true
  },
  {
   "id": "num-eq-field-same",
   "expr": "${n} = ${n2}",
   "doc": {
    "n": 7,
    "n2": 7
   },
   "expected": true
  },
  {
   "id": "num-eq-field-oneblank",
   "expr": "${n} = ${n2}",
   "doc": {
    "n": 7,
    "n2": null
   },
   "expected": false
  },
  {
   "id": "num-eq-field-diff",
   "expr": "${n} = ${n2}",
   "doc": {
    "n": 7,
    "n2": 8
   },
   "expected": false
  },
  {
   "id": "num-ne-field-oneblank",
   "expr": "${n} != ${n2}",
   "doc": {
    "n": 7,
    "n2": null
   },
   "expected": true
  },
  {
   "id": "num-dec-gt",
   "expr": "${d} > 2.5",
   "doc": {
    "d": 2.6
   },
   "expected": true
  },
  {
   "id": "num-dec-eq",
   "expr": "${d} > 2.5",
   "doc": {
    "d": 2.5
   },
   "expected": false
  },
  {
   "id": "num-dec-blank",
   "expr": "${d} > 2.5",
   "doc": {
    "d": null
   },
   "expected": false
  },
  {
   "id": "num-dec-eq-int",
   "expr": "${d} = 3",
   "doc": {
    "d": 3.0
   },
   "expected": true
  },
  {
